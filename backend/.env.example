# Anthropic API key for Claude vision extraction (backend only). Required.
ANTHROPIC_API_KEY=your-api-key-here

# Optional override for the Claude model used for extraction.
# Default in-code production model is claude-sonnet-4-5.
CLAUDE_MODEL=claude-sonnet-4-6

# Optional fast-extraction feature flag for faster/cheaper development and testing.
# Default: false (OFF by default to preserve production Sonnet accuracy).
# Set to true in -dev environments to use the fast extraction model.
USE_FAST_EXTRACTION=false

# Optional model to use when USE_FAST_EXTRACTION=true.
# Default: claude-haiku-4-5
EXTRACTION_FAST_MODEL=claude-haiku-4-5

# Comma-separated list of allowed CORS origins (the frontend hostname[s]).
# When UNSET (default), the backend uses the production allowlist:
# local Vite (localhost/127.0.0.1:5173) plus the Render frontend from
# render.yaml (https://ttb-label-frontend.onrender.com).
# Empty or invalid values also use that allowlist — never '*'.
# Explicit '*' is honored only outside production and always logs a warning.
# Priority: ALLOWED_ORIGINS > CORS_ALLOWED_ORIGINS > CORS_ORIGINS.
# ALLOWED_ORIGINS=https://ttb-label-frontend.onrender.com

# ---- Rate Limiting & Concurrency Guardrails (Fail-Open / Soft Caps) ------
# Rate limit for expensive review endpoints (/api/review, /api/review/batch,
# /api/review/batch/stream, /api/label-check/batch). Keyed by client IP.
# Exceeding this returns HTTP 429 Too Many Requests (never 401/403). Health & demo-info are unlimited.
# Default: 20/minute
RATE_LIMIT_REVIEW=20/minute

# Process-wide concurrency cap for parallel Claude vision extraction calls.
# Prevents unbounded-parallel burn of Anthropic API credits during batch floods.
# Default: 5
MAX_CONCURRENT_CLAUDE_CALLS=5

# Maximum time (seconds) to wait for Claude extraction concurrency slot before returning a friendly 503/429 busy message.
# Default: 30.0
CLAUDE_CONCURRENCY_TIMEOUT=30.0

# Per-client-IP daily review cap. HTTP 429 / RATE_LIMITED when exceeded.
# Counted only after upload validation and the quality pre-gate.
# 0 disables. Default: 500
DAILY_REQUEST_SOFT_CAP=500

# Process-wide daily review cap (all clients). 0 disables. Default: 10000
MAX_REVIEW_REQUESTS_PER_DAY=10000

# X-Forwarded-For hops added by the trusted reverse proxy.
# Rate-limit keys use the right-most trusted hop. Default: 1
TRUSTED_PROXY_HOPS=1

# Total HTTP request body cap (all files + form fields). HTTP 413 when exceeded.
# Default: 52428800 (50 MB). /api/health is never blocked by this guard.
MAX_REQUEST_BODY_BYTES=52428800

# Maximum labels accepted on batch and stream review endpoints. Default: 50
MAX_LABELS_PER_BATCH=50

# Maximum COLA template upload size for /api/cola/parse-template. Default: 1048576 (1 MB)
MAX_TEMPLATE_BYTES=1048576

# Failed-auth lockout: this many 401s from one client IP in the window returns 429.
# Default: 10 failures / 600 seconds. /api/health stays public. Guards fail open.
AUTH_LOCKOUT_FAILURES=10
AUTH_LOCKOUT_WINDOW_SECONDS=600

# Mount /docs, /redoc, and /openapi.json only when true. Default: unset (disabled).
ENABLE_API_DOCS=false

# ---- Demo access gate (optional) ----------------------------------------
# IMPORTANT: Leave DEMO_ACCESS_TOKEN unset for public TTB evaluator demos!
# Evaluators must ALWAYS access the app without mandatory credentials or lockout.
# When DEMO_ACCESS_TOKEN is set, the review endpoints require the header
#   Authorization: Bearer <DEMO_ACCESS_TOKEN>
# and the frontend shows a login screen. When it is UNSET the app is open
# (fail-open) — this is the default local-dev and public demo behavior.
# Never enable by default. Do not add API_AUTH_TOKEN.
DEMO_ACCESS_TOKEN=

# Optional operator-only display name. /api/demo-info does not return a username.
DEMO_USERNAME=
