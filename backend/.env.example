# Anthropic API key for Claude vision extraction (backend only). Required.
ANTHROPIC_API_KEY=your-api-key-here

# Optional override for the Claude model used for extraction.
# Default in-code production model is claude-sonnet-4-5.
CLAUDE_MODEL=claude-sonnet-4-6

# Optional fast-extraction feature flag for faster/cheaper development and testing.
# Default: false (OFF by default to preserve production Sonnet accuracy).
# Set to true in -dev environments to use the fast extraction model.
USE_FAST_EXTRACTION=false

# Optional model to use when USE_FAST_EXTRACTION=true.
# Default: claude-3-5-haiku-latest
EXTRACTION_FAST_MODEL=claude-3-5-haiku-latest

# Comma-separated list of allowed CORS origins (the frontend hostname[s]).
# Defaults to "*" (fail-open) when unset or empty, ensuring evaluators and
# the production frontend (https://ttb-label-frontend.onrender.com) are never blocked.
# Set this to explicit origin(s) if cross-origin lockdown is desired.
# Example: CORS_ORIGINS=https://ttb-label-frontend.onrender.com,http://localhost:5173
CORS_ORIGINS=

# ---- Auth Policy: Fail-Open / Zero-Login ------------------------------------
# Authentication is intentionally NOT enabled (fail-open / zero-login product requirement).
# Evaluators and compliance reviewers must always have unobstructed access.
# Never configure API auth gates that return 401/403 for missing credentials.
# DEMO_ACCESS_TOKEN and DEMO_USERNAME remain optional demonstration-grade settings
# that fail-open when unconfigured.
DEMO_ACCESS_TOKEN=
DEMO_USERNAME=ttb-demo
