# Anthropic API key for Claude vision extraction (backend only). Required.
ANTHROPIC_API_KEY=your-api-key-here

# Optional override for the Claude model used for extraction.
# Default in-code production model is claude-sonnet-4-5.
CLAUDE_MODEL=claude-sonnet-4-6

# Optional fast-extraction feature flag for faster/cheaper development and testing.
# Default: false (OFF by default to preserve production Sonnet accuracy).
# Set to true in -dev environments to use the fast extraction model.
USE_FAST_EXTRACTION=false

# Optional model to use when USE_FAST_EXTRACTION=true.
# Default: claude-3-5-haiku-latest
EXTRACTION_FAST_MODEL=claude-3-5-haiku-latest

# Comma-separated list of allowed CORS origins (the frontend hostname[s]).
# Leave unset for local dev and public evaluator demos (defaults to "*", with a startup warning).
# For strict production locking, set this to the exact frontend URL (e.g. https://ttb-label-frontend.onrender.com).
# Note: Keep fail-open "*" when CORS_ORIGINS is unset so evaluators and preview URLs are never blocked.
# Example: CORS_ORIGINS=https://ttb-label-frontend.onrender.com
CORS_ORIGINS=

# ---- Rate Limiting & Concurrency Guardrails (Fail-Open / Soft Caps) ------
# Rate limit for expensive review endpoints (/api/review, /api/review/batch,
# /api/review/batch/stream, /api/label-check/batch). Keyed by client IP.
# Exceeding this returns HTTP 429 Too Many Requests (never 401/403). Health & demo-info are unlimited.
# Default: 20/minute
RATE_LIMIT_REVIEW=20/minute

# Process-wide concurrency cap for parallel Claude vision extraction calls.
# Prevents unbounded-parallel burn of Anthropic API credits during batch floods.
# Default: 5
MAX_CONCURRENT_CLAUDE_CALLS=5

# Maximum time (seconds) to wait for Claude extraction concurrency slot before returning a friendly 503/429 busy message.
# Default: 30.0
CLAUDE_CONCURRENCY_TIMEOUT=30.0

# Optional daily spend / abuse soft guardrail. Tracks request count and logs a loud WARNING
# when threshold is crossed without hard-blocking evaluator access. Single-process counter is used
# on Render free tier (multi-instance will require Redis later).
# Default: 0 (disabled / soft logging only)
# Example: MAX_REVIEW_REQUESTS_PER_DAY=500
MAX_REVIEW_REQUESTS_PER_DAY=0

# ---- Auth Policy: Fail-Open / Zero-Login ------------------------------------
# IMPORTANT: Leave DEMO_ACCESS_TOKEN unset for public TTB evaluator demos!
# Evaluators must ALWAYS access the app without mandatory credentials or lockout.
# When DEMO_ACCESS_TOKEN is set, the review endpoints require the header
#   Authorization: Bearer <DEMO_ACCESS_TOKEN>
# and the frontend shows a login screen. When it is UNSET the app is open
# (fail-open) — this is the default local-dev and public demo behavior.
# Never enable by default. Do not add API_AUTH_TOKEN.
DEMO_ACCESS_TOKEN=
DEMO_USERNAME=ttb-demo

